# --- OpenRouter (OpenAI-compatible) ---
# Conseguí la key en https://openrouter.ai/keys y pegala acá.
OPENROUTER_API_KEY=
# Modelo (free). Cambialo si el tool-calling no responde bien.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Temperatura: 0 = más determinista (recomendado para tool-calling y evals).
OPENROUTER_TEMPERATURE=0
# Base URL (por defecto la de OpenRouter; no suele hacer falta tocarla).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opcionales: OpenRouter los usa para atribución/ranking. Podés dejarlos vacíos.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=WhatsApp Asset Bot

# --- DB ---
DB_PATH=./data.db
